{
  "name": "@my-project/trpc",
  "version": "0.11.0-SNAPSHOT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "tsc": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "generate:openapi": "tsx scripts/generate-openapi.ts api/openapi.json",
    "generate:substrate": "buf generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@fastify/session": "^11.1.0",
    "@kubernetes/client-node": "^1.4.0",
    "@my-project/shared": "workspace:*",
    "@trpc/server": "^11.8.0",
    "fastify": "^5.8.5",
    "jose": "^6.1.0",
    "node-fetch": "^3.3.2",
    "openid-client": "^6.5.0",
    "trpc-to-openapi": "2.4.0",
    "zod": "^3.24.2",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@peculiar/x509": "^3.1.0",
    "@types/node": "^22.13.5",
    "@types/node-fetch": "^2.6.13",
    "@types/openid-client": "^3.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
