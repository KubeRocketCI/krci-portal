#!/usr/bin/env bash
# Blocks a commit on main, on a branch not named EPMDEDP-<n>/<short-slug>, and a commit whose staged contents fail prettier --check.
# Installed by the root prepare script (pnpm install).
# Git runs this after it prepares the commit's index: covers git add && git commit, commit -a, commit <paths>, partial staging.
# A detached HEAD (rebase) passes the branch checks. A format check that cannot run does not block; CI checks format again.
branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "main" ]; then
  echo "Commit blocked: HEAD is main. Fix: git switch -c EPMDEDP-<n>/<short-slug> (docs/agents/issue-tracker.md), then commit." >&2
  exit 1
fi
if [ -n "$branch" ] && ! [[ "$branch" =~ ^EPMDEDP-[0-9]+/[^/]+$ ]]; then
  echo "Commit blocked: branch '$branch' is not EPMDEDP-<n>/<short-slug> (docs/agents/issue-tracker.md). Fix: git branch -m EPMDEDP-<n>/<short-slug>, then commit." >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
[ -f "$root/scripts/check-changed.sh" ] || exit 0

bash "$root/scripts/check-changed.sh" --staged
status=$?
case "$status" in
  0) exit 0 ;;
  3)
    echo "Commit blocked: staged contents are not formatted. Fix: pnpm check:changed, then git add the formatted files." >&2
    exit 1
    ;;
  *)
    echo "pre-commit: format check could not run (exit $status); commit not blocked." >&2
    exit 0
    ;;
esac
